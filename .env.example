# Copie este arquivo para .env.local (desenvolvimento) e nunca faça commit
# de .env.local ou de qualquer arquivo com segredos reais.

# --- Supabase ---
# Local: valores impressos por `supabase start`. Produção: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha com o prefixo NEXT_PUBLIC_. Usada só em código server-only
# (exclusão de conta, Edge Function de lembretes).
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID) ---
# Gere com: npx tsx scripts/generate-vapid-keys.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo Web Push (RFC 8292), formato mailto:
VAPID_SUBJECT=mailto:contato@example.com

# --- Site ---
# URL pública do deploy atual (usada para montar links de e-mail/redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
